# ---- Client (safe to expose to the browser; VITE_ prefix only) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_NAME=CleanBid
VITE_APP_VERSION=0.1.0

# ====================================================================
# SERVER-ONLY secrets for the /api/send-proposal Vercel Function.
# These are NOT prefixed with VITE_ and are NEVER bundled into the
# client. Set them in the Vercel project environment (or a local .env
# when running `vercel dev`), never in the browser.
# ====================================================================

# Supabase service-role key (bypasses RLS). Server-side use ONLY.
# Find it at: Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend transactional email.
# Get a key at https://resend.com/api-keys (free tier).
RESEND_API_KEY=re_xxx
# Verified sender. Until you verify your own domain, Resend allows the
# testing sender below. DO NOT invent a verified domain here.
# Production: set this to e.g. "CleanBid <proposals@yourdomain.com>"
RESEND_FROM=CleanBid <onboarding@resend.dev>

# Local/dev only: when RESEND_API_KEY is absent and this is "1" (or the
# environment is not production), the function runs a dry-run that
# simulates a successful send so the full pipeline can be tested without
# external credentials. In production with no key, sends fail gracefully.
ALLOW_DRY_RUN_SEND=1
